# MOSFET forecasting portfolio
# Keep source code, requirements, Markdown, CSV/JSON results, final charts,
# and PDF reports. Ignoring a file does not delete the local copy.
# These rules apply to untracked files; already-tracked files stay tracked.

# Raw measurements and generated MATLAB data dumps
# Obtain the original dataset separately using the README instructions.
*.mat
/MOSFET_Thermal_Overstress_Aging/matlab_scripts/
# The optional MATLAB text exporter is excluded below; modeling reads .mat.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Python environments and generated bytecode
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Dependencies and local editor settings
node_modules/
.vscode/
.idea/

# Local configuration and credentials
.env
.env.*
!.env.example
!.env.template
.aws/
.codex/

# Reproducible intermediate data and plotting caches
/mosfet_forecasting/cache/
.matplotlib/
.cache/
.build/
.review/
/tmp/
/temp/
*.log
*.tmp
*.bak
*.inspect.ndjson

# Office source/draft files and duplicate Excel exports
# Publish the selected PDF report; CSV files remain available for analysis.
# Remove a rule or add a specific ! exception if an editable file is needed.
*.docx
*.pptx
*.xlsx
~$*
/mosfet_forecasting/excel_exports/
/.excel_conversion_details/
/excel_conversion_verification.json

# Optional Python utilities omitted from the public portfolio
# Exact paths preserve analysis/reproducibility scripts elsewhere.
# Excel copies are excluded above; publish the original CSV results instead.
/repair_excel_dates.py
/verify_csv_excel.py
# Local PowerPoint insertion depends on unpublished editable decks.
/mosfet_forecasting/engineering_cases/insert_slide.py
/mosfet_forecasting/validation_scope/insert_slide.py
# Older beige chart export; retain export_white_charts.py for final figures.
/mosfet_forecasting/engineering_cases/export_chart_jpg.py
# Optional .mat-to-.m conversion is outside the forecasting workflow.
# Its numeric reshape export defect is documented in pdf_matlab_review/.
/MOSFET_Thermal_Overstress_Aging/mat_to_m.py

# Local slide/chart construction and review artifacts
/.chart-data-*/
/.ppt_motivation_build/
/presentation_output/
/mosfet_forecasting/engineering_cases/.build/
/mosfet_forecasting/engineering_cases/source_slide_*.png
/mosfet_forecasting/engineering_cases/slide_inventory.png
/mosfet_forecasting/validation_scope/source_*.png
/mosfet_forecasting/validation_scope/current_review_*.png
/mosfet_forecasting/validation_scope/readme_pdf_*.png
/mosfet_forecasting/validation_scope/inventory.jpg
/pdf_matlab_review/page_*.png
/pdf_matlab_review/overview.jpg
/publication/pdf_consistency/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Intentionally retained (no blanket ignore rules):
# mosfet_forecasting/results/ -- features, predictions, metrics, metadata
# mosfet_forecasting/sensitivity_*/ -- sensitivity experiment results
# mosfet_forecasting/engineering_cases/ -- analysis, results, final charts
# pdf_matlab_review/ -- review scripts and numerical evidence
# *.pdf -- select the final report when staging files for publication
# README.md, requirements.txt, *.py (except exact exclusions above),
# *.mjs, *.csv, *.json
